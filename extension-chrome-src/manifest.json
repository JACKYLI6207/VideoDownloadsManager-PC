{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.9",
  "description": "__MSG_extDesc__",
  "default_locale": "zh_TW",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "tabGroups",
    "alarms",
    "cookies",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:18429/*"],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "Video Downloads Manager",
    "default_popup": "sidepanel/panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/utils.js", "lib/detector.js", "content/sniffer.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
